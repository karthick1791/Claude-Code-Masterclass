{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git status)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(ls *)",
      "Bash(Get-ChildItem -Path \"C:\\\\Users\\\\Karthick\\\\git\\\\Claude-Code-Masterclass\" -Recurse -Directory -Filter \"app\")",
      "Bash(Select-Object -ExpandProperty FullName)",
      "mcp__context7__query-docs",
      "mcp__firebase__firebase_get_environment",
